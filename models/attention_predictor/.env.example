# Copy to .env beside this file (gitignored) and set the values for this machine.

# Root holding datasets/, generated/, embeddings/, and models/sd-turbo.
CHORDEDIT_DATA_ROOT=/path/to/chordedit-data

# Optional: weights stored outside $CHORDEDIT_DATA_ROOT/models/.
# SDXL_TURBO_PATH=/path/to/sdxl-turbo
# FLUX_PATH=/path/to/flux1-schnell

# Weights & Biases tracking for train.py.
WANDB_API_KEY=
# WANDB_ENTITY=your-team-or-username
